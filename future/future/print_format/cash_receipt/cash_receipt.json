 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format {\n        font-family: Arial, \"Helvetica Neue\", Helvetica, sans-serif;\n        font-size: 10pt;\n        color: #333;\n    }\n    @media screen {\n        .print-format {\n            width: 8.27in;\n            min-height: 11.69in;\n            padding: 0.4in;\n        }\n    }\n    .header-table {\n        width: 100%;\n        border-bottom: 3px solid #c41230;\n        margin-bottom: 15px;\n    }\n    .header-table td {\n        padding: 12px 0;\n        vertical-align: middle;\n    }\n    .company-name {\n        font-size: 20pt;\n        font-weight: bold;\n        color: #c41230;\n        margin-bottom: 4px;\n    }\n    .company-tagline {\n        font-size: 11pt;\n        color: #555;\n        margin-bottom: 8px;\n    }\n    .receipt-title {\n        text-align: center;\n        font-size: 16pt;\n        font-weight: bold;\n        margin: 18px 0;\n        background: #f5f5f5;\n        padding: 10px;\n        border: 1px solid #ddd;\n        color: #c41230;\n        letter-spacing: 1px;\n    }\n    .info-table {\n        width: 100%;\n        margin-bottom: 18px;\n        border-collapse: collapse;\n    }\n    .info-table td {\n        width: 50%;\n        vertical-align: top;\n        padding: 0;\n    }\n    .info-box {\n        border: 1px solid #ddd;\n        padding: 12px;\n        background: #fafafa;\n        min-height: 110px;\n    }\n    .info-box-left {\n        margin-right: 8px;\n    }\n    .info-box-right {\n        margin-left: 8px;\n    }\n    .info-box-title {\n        font-weight: bold;\n        border-bottom: 2px solid #c41230;\n        margin-bottom: 10px;\n        padding-bottom: 5px;\n        color: #c41230;\n        font-size: 11pt;\n    }\n    .info-box table {\n        width: 100%;\n    }\n    .info-box td {\n        padding: 3px 0;\n        font-size: 10pt;\n    }\n    table.items {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 18px;\n    }\n    table.items th {\n        background: #c41230;\n        color: white;\n        padding: 9px;\n        text-align: left;\n        font-size: 10pt;\n    }\n    table.items td {\n        padding: 8px;\n        border-bottom: 1px solid #ddd;\n        vertical-align: top;\n    }\n    table.items tr:nth-child(even) {\n        background: #f9f9f9;\n    }\n    .text-right {\n        text-align: right !important;\n    }\n    .totals {\n        width: 45%;\n        margin-left: auto;\n        margin-top: 18px;\n        border-collapse: collapse;\n    }\n    .totals td {\n        padding: 7px;\n        border-bottom: 1px solid #ddd;\n    }\n    .grand-total {\n        font-size: 11pt;\n        font-weight: bold;\n        background: #f0f0f0;\n    }\n    .in-words {\n        font-style: italic;\n        color: #555;\n    }\n    .terms {\n        margin-top: 25px;\n        border-top: 1px solid #ddd;\n        padding-top: 12px;\n        page-break-inside: avoid;\n    }\n    .terms-title {\n        font-weight: bold;\n        color: #c41230;\n        margin-bottom: 6px;\n    }\n    .footer-table {\n        width: 100%;\n        margin-top: 50px;\n    }\n    .signature {\n        width: 220px;\n        border-top: 1px solid #333;\n        text-align: center;\n        padding-top: 6px;\n        margin-left: auto;\n        font-weight: bold;\n    }\n    @media print {\n        .print-format {\n            padding: 0;\n        }\n    }\n</style>\n\n<table class=\"header-table\">\n    <tr>\n        <td>\n            <img src=\"/private/files/WhatsApp Image 2026-09-20 at 16.26.09.jpeg\" style=\"max-width: 220px; max-height: 90px;\" alt=\"Future logo\">\n        </td>\n        <td style=\"text-align: right;\">\n            <div class=\"company-name\">Future</div>\n            <div class=\"company-tagline\">powered by Gokulam</div>\n            <div>Building No. 1812/A, Mulloli Plaza</div>\n            <div>Mini Bypass, Eranhipalam, Kozhikode</div>\n            <div>Kerala - 673006</div>\n            <div><b>Email:</b> info@edfuture.in | <b>Phone:</b> +91 99952 00700</div>\n        </td>\n    </tr>\n</table>\n\n<div class=\"receipt-title\">CASH RECEIPT</div>\n\n<table class=\"info-table\">\n    <tr>\n        <td>\n            <div class=\"info-box info-box-left\">\n                <div class=\"info-box-title\">Receipt Details</div>\n                <table>\n                    <tr><td style=\"white-space: nowrap;\"><b>Receipt No</b></td><td style=\"white-space: nowrap;\">: {{ doc.name }}</td></tr>\n                    <tr><td><b>Date</b></td><td>: {{ doc.get_formatted(\"date\") or \"-\" }}</td></tr>\n                    <tr><td><b>Transaction Date</b></td><td>: {{ doc.get_formatted(\"transaction_date\") or \"-\" }}</td></tr>\n                    <tr><td><b>Mode of Payment</b></td><td>: {{ doc.mode_of_payment or \"-\" }}</td></tr>\n                </table>\n            </div>\n        </td>\n        <td>\n            <div class=\"info-box info-box-right\">\n                <div class=\"info-box-title\">Student Details</div>\n                <table>\n                    <tr><td style=\"white-space: nowrap;\"><b>Student ID</b></td><td style=\"white-space: nowrap;\">: {{ doc.student_id or \"-\" }}</td></tr>\n                    <tr><td style=\"white-space: nowrap;\"><b>Name</b></td><td>: {{ doc.student_name or doc.student or \"-\" }}</td></tr>\n                    <tr><td style=\"white-space: nowrap;\"><b>Email</b></td><td style=\"white-space: nowrap;\">: {{ doc.email_id or \"-\" }}</td></tr>\n                    <tr><td style=\"white-space: nowrap;\"><b>Phone</b></td><td>: {{ doc.mobile_number or \"-\" }}</td></tr>\n                </table>\n            </div>\n        </td>\n    </tr>\n</table>\n\n<table class=\"items\">\n    <thead>\n        <tr>\n            <th width=\"5%\">#</th>\n            <th width=\"65%\">Particulars</th>\n            <th width=\"30%\" class=\"text-right\">Received Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% set ns = namespace(idx=0) %}\n        {% if doc.fee_details %}\n            {% for d in doc.fee_details %}\n                {% set ns.idx = ns.idx + 1 %}\n                <tr>\n                    <td>{{ ns.idx }}</td>\n                    <td>Fee - {{ d.components or \"-\" }}</td>\n                    <td class=\"text-right\">{{ d.get_formatted(\"received_amount\") }}</td>\n                </tr>\n            {% endfor %}\n        {% endif %}\n        {% if doc.hostel_components %}\n            {% for d in doc.hostel_components %}\n                {% set ns.idx = ns.idx + 1 %}\n                <tr>\n                    <td>{{ ns.idx }}</td>\n                    <td>Hostel Fee - {{ d.components or \"-\" }}</td>\n                    <td class=\"text-right\">{{ d.get_formatted(\"received_amount\") }}</td>\n                </tr>\n            {% endfor %}\n        {% endif %}\n        {% if doc.vehicle_components %}\n            {% for d in doc.vehicle_components %}\n                {% set ns.idx = ns.idx + 1 %}\n                <tr>\n                    <td>{{ ns.idx }}</td>\n                    <td>Transport Fee - {{ d.components or \"-\" }}</td>\n                    <td class=\"text-right\">{{ d.get_formatted(\"received_amount\") }}</td>\n                </tr>\n            {% endfor %}\n        {% endif %}\n        {% if ns.idx == 0 %}\n            <tr>\n                <td colspan=\"3\" style=\"color: #777;\">No fee details recorded.</td>\n            </tr>\n        {% endif %}\n    </tbody>\n</table>\n\n<table class=\"totals\">\n    <tr class=\"grand-total\">\n        <td width=\"60%\"><b>Total Received Amount</b></td>\n        <td width=\"40%\" class=\"text-right\">{{ doc.get_formatted(\"total_bill_amount\") }}</td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" class=\"in-words\"><b>In Words:</b> {{ frappe.utils.money_in_words(doc.total_bill_amount or 0) }}</td>\n    </tr>\n</table>\n\n<div class=\"terms\">\n    <div class=\"terms-title\">Received With Thanks</div>\n    This is a computer generated Cash Receipt. No signature is required.\n</div>\n\n<table class=\"footer-table\">\n    <tr>\n        <td></td>\n        <td style=\"text-align: right; vertical-align: bottom;\">\n            <div class=\"signature\">Authorized Signature</div>\n        </td>\n    </tr>\n</table>\n",
