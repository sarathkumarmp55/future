 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format {\n        font-family: Arial, \"Helvetica Neue\", Helvetica, sans-serif;\n        font-size: 10pt;\n        color: #333;\n    }\n    @media screen {\n        .print-format {\n            width: 8.27in;\n            min-height: 11.69in;\n            padding: 0.4in;\n        }\n    }\n    .header-table {\n        width: 100%;\n        border-bottom: 3px solid #c41230;\n        margin-bottom: 15px;\n    }\n    .header-table td {\n        padding: 12px 0;\n        vertical-align: middle;\n    }\n    .company-name {\n        font-size: 20pt;\n        font-weight: bold;\n        color: #c41230;\n        margin-bottom: 4px;\n    }\n    .company-tagline {\n        font-size: 11pt;\n        color: #555;\n        margin-bottom: 8px;\n    }\n    .receipt-title {\n        text-align: center;\n        font-size: 16pt;\n        font-weight: bold;\n        margin: 18px 0;\n        background: #f5f5f5;\n        padding: 10px;\n        border: 1px solid #ddd;\n        color: #c41230;\n        letter-spacing: 1px;\n    }\n    .info-table {\n        width: 100%;\n        margin-bottom: 18px;\n        border-collapse: collapse;\n    }\n    .info-table td {\n        width: 50%;\n        vertical-align: top;\n        padding: 0;\n    }\n    .info-box {\n        border: 1px solid #ddd;\n        padding: 12px;\n        background: #fafafa;\n        min-height: 110px;\n    }\n    .info-box-left {\n        margin-right: 8px;\n    }\n    .info-box-right {\n        margin-left: 8px;\n    }\n    .info-box-title {\n        font-weight: bold;\n        border-bottom: 2px solid #c41230;\n        margin-bottom: 10px;\n        padding-bottom: 5px;\n        color: #c41230;\n        font-size: 11pt;\n    }\n    .info-box table {\n        width: 100%;\n    }\n    .info-box td {\n        padding: 3px 0;\n        font-size: 10pt;\n    }\n    table.items {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 18px;\n    }\n    table.items th {\n        background: #c41230;\n        color: white;\n        padding: 9px;\n        text-align: left;\n        font-size: 10pt;\n    }\n    table.items td {\n        padding: 8px;\n        border-bottom: 1px solid #ddd;\n        vertical-align: top;\n    }\n    table.items tr:nth-child(even) {\n        background: #f9f9f9;\n    }\n    .text-right {\n        text-align: right !important;\n    }\n    .totals {\n        width: 45%;\n        margin-left: auto;\n        margin-top: 18px;\n        border-collapse: collapse;\n    }\n    .totals td {\n        padding: 7px;\n        border-bottom: 1px solid #ddd;\n    }\n    .grand-total {\n        font-size: 11pt;\n        font-weight: bold;\n        background: #f0f0f0;\n    }\n    .in-words {\n        font-style: italic;\n        color: #555;\n    }\n    .terms {\n        margin-top: 25px;\n        border-top: 1px solid #ddd;\n        padding-top: 12px;\n        page-break-inside: avoid;\n    }\n    .terms-title {\n        font-weight: bold;\n        color: #c41230;\n        margin-bottom: 6px;\n    }\n    .footer-table {\n        width: 100%;\n        margin-top: 50px;\n    }\n    .signature {\n        width: 220px;\n        border-top: 1px solid #333;\n        text-align: center;\n        padding-top: 6px;\n        margin-left: auto;\n        font-weight: bold;\n    }\n    .gst-info {\n        font-size: 9pt;\n        color: #555;\n    }\n    @media print {\n        .print-format {\n            padding: 0;\n        }\n    }\n</style>\n\n<table class=\"header-table\">\n    <tr>\n        <td>\n            <img src=\"/private/files/WhatsApp Image 2026-09-20 at 16.26.09.jpeg\" style=\"max-width: 220px; max-height: 90px;\" alt=\"Future logo\">\n        </td>\n        <td style=\"text-align: right;\">\n            <div class=\"company-name\">Future</div>\n            <div class=\"company-tagline\">powered by Gokulam</div>\n            <div>Building No. 1812/A, Mulloli Plaza</div>\n            <div>Mini Bypass, Eranhipalam, Kozhikode</div>\n            <div>Kerala - 673006</div>\n            <div><b>Email:</b> info@edfuture.in | <b>Phone:</b> +91 99952 00700</div>\n        </td>\n    </tr>\n</table>\n\n<div class=\"receipt-title\">FEE RECEIPT</div>\n\n<table class=\"info-table\">\n    <tr>\n        <td>\n            <div class=\"info-box info-box-left\">\n                <div class=\"info-box-title\">Invoice Details</div>\n                <table>\n                    <tr><td style=\"white-space: nowrap;\"><b>Invoice No</b></td><td style=\"white-space: nowrap;\">: {{ doc.name }}</td></tr>\n                    <tr><td><b>Date</b></td><td>: {{ doc.get_formatted(\"posting_date\") }}</td></tr>\n                    <tr><td><b>Due Date</b></td><td>: {{ doc.get_formatted(\"due_date\") }}</td></tr>\n                    <tr><td><b>Payment Status</b></td><td>: Paid</td></tr>\n                </table>\n            </div>\n        </td>\n        <td>\n            <div class=\"info-box info-box-right\">\n                <div class=\"info-box-title\">Student Details</div>\n                {% if doc.student %}\n                    {% set s = frappe.db.get_value(\"Student\", doc.student, [\"student_name\", \"student_email_id\", \"student_mobile_number\", \"date_of_birth\", \"gender\"], as_dict=True) %}\n                    <table>\n                        <tr><td style=\"white-space: nowrap;\"><b>Student ID</b></td><td>: {{ doc.student }}</td></tr>\n                        <tr><td style=\"white-space: nowrap;\"><b>Name</b></td><td>: {{ s.student_name or \"-\" }}</td></tr>\n                        <tr><td style=\"white-space: nowrap;\"><b>Email</b></td><td style=\"white-space: nowrap;\">: {{ s.student_email_id or \"-\" }}</td></tr>\n                        <tr><td style=\"white-space: nowrap;\"><b>Phone</b></td><td>: {{ s.student_mobile_number or \"-\" }}</td></tr>\n                    </table>\n                {% else %}\n                    <p style=\"margin: 0; color: #777;\">No student linked to this invoice.</p>\n                {% endif %}\n            </div>\n        </td>\n    </tr>\n</table>\n\n<table class=\"items\">\n    <thead>\n        <tr>\n            <th width=\"5%\">#</th>\n            <th width=\"45%\">Item / Description</th>\n            <th width=\"15%\" class=\"text-right\">Rate</th>\n            <th width=\"10%\" class=\"text-right\">Qty</th>\n            <th width=\"25%\" class=\"text-right\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>\n                <b>{{ item.item_name or item.item_code }}</b><br>\n                <small style=\"color: #666;\">{{ item.description or \"\" }}</small>\n            </td>\n            <td class=\"text-right\">{{ item.get_formatted(\"rate\") }}</td>\n            <td class=\"text-right\">{{ item.qty }}</td>\n            <td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<table class=\"totals\">\n    <tr>\n        <td width=\"60%\"><b>Subtotal</b></td>\n        <td width=\"40%\" class=\"text-right\">{{ doc.get_formatted(\"net_total\") }}</td>\n    </tr>\n    {% for tax in doc.taxes %}\n    <tr>\n        <td><b>{{ tax.description }}</b></td>\n        <td class=\"text-right\">{{ tax.get_formatted(\"tax_amount\") }}</td>\n    </tr>\n    {% endfor %}\n    <tr class=\"grand-total\">\n        <td><b>Grand Total (Incl. Tax)</b></td>\n        <td class=\"text-right\">{{ doc.get_formatted(\"grand_total\") }}</td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" class=\"in-words\"><b>In Words:</b> {{ doc.in_words or \"-\" }}</td>\n    </tr>\n</table>\n\n\n<div class=\"terms\">\n    <div class=\"terms-title\">Terms & Conditions</div>\n    . This\tis\tcomputer\tgenerated\tTax\tInvoice,\thence\tNo\tSignature\tis\trequired \u00b7\t<br>. All\tdisputes\tare\tsubject\tto\t(Branch,\tState\tname)\tjurisdictions\tonly \u00b7\t<br>. Subject\tto\tthe\trealization\tof\tCheque\tand\tDemand\tDraft\n</div>\n\n\n<table class=\"footer-table\">\n    <tr>\n        <td class=\"gst-info\">\n            <!--<p><b>Tax Payable on Reverse Charge:</b> No</p>-->\n            <p><b>Company GSTIN:</b> {{ doc.company_gstin or \"12345654\" }}</p>\n        </td>\n        <td style=\"text-align: right; vertical-align: bottom;\">\n            <div class=\"signature\">Authorized Signature</div>\n        </td>\n    </tr>\n</table>",
